#!name=适配可莉插件中心
#!desc=支持可莉插件中心的插件给Surge使用; 非Loon用户切勿反馈插件任何问题，尊重原创; 使用前请先添加ScriptHub模块. 插件中心网址 https://pluginhub.kelee.one
#!icon = https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/refs/heads/main/assets/icon192x192.png
#!category= 可莉插件中心
#!author=原作者@iKeLee
#!arguments = endpoint:script.hub
#!arguments-desc = endpoint: 服务端点

[Body Rewrite]
http-response https://(hub|pluginhub)\.kelee\.one/list\.json "loon://import\?plugin=(https://kelee.one/Tool/Loon/Lpx/(.+).lpx)" "surge:///install-module?url=https://{{{endpoint}}}/file/_start_/$1/_end_/$2.sgmodule%3Ftype%3Dloon-plugin%26target%3Dsurge-module%26del%3Dtrue%26jqEnabled%3Dtrue%26pm%3D.%26sni%3D.%26category%3DiKeleeHub"

[Header Rewrite]
# 清缓存头
http-request https://(hub|pluginhub)\.kelee\.one/list\.json header-del if-none-match

[MITM]
hostname = %APPEND% hub.kelee.one, pluginhub.kelee.one
